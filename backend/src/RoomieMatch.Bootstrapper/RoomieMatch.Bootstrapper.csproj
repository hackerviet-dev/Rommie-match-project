<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <Content Include="..\..\..\database\migrations\*.sql"
             Link="Migrations\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="..\Modules\Users\RoomieMatch.Modules.Users.csproj" />
    <ProjectReference Include="..\Modules\Matching\RoomieMatch.Modules.Matching.csproj" />
    <ProjectReference Include="..\Modules\Hyperlocal\RoomieMatch.Modules.Hyperlocal.csproj" />
    <ProjectReference Include="..\Modules\Rooms\RoomieMatch.Modules.Rooms.csproj" />
    <ProjectReference Include="..\Modules\Billing\RoomieMatch.Modules.Billing.csproj" />
    <ProjectReference Include="..\Shared\RoomieMatch.Shared\RoomieMatch.Shared.csproj" />
    <ProjectReference Include="..\Modules\Chat\RoomieMatch.Modules.Chat.csproj" />
    <ProjectReference Include="..\Modules\Media\RoomieMatch.Modules.Media.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Demo accounts are only seeded by local Docker Compose, never in production. -->
    <Content Include="..\..\..\database\init\*.sql" Exclude="..\..\..\database\init\002_seed.sql"
             Link="Migrations\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
