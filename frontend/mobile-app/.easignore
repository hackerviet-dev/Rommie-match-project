# EAS Build đọc file này thay cho .gitignore khi tải mã nguồn lên.
# android/ và ios/ là thư mục native cũ từ thời React Native CLI (mã gói com.roomiematchmobile).
# Bỏ chúng đi để EAS tự sinh lại (prebuild) từ app.json với mã gói vn.roomiematch.mobile.
/android
/ios
Gemfile
index.js

# Giống .gitignore
node_modules/
.expo/
dist/
web-build/
