POSTGRES_DB=roomiematch
POSTGRES_USER=roomiematch
POSTGRES_PASSWORD=roomiematch_dev
POSTGRES_PORT=55432
API_PORT=5000
WEB_PORT=3100
# "mock" = test gateway that never charges money. Leave empty to disable checkout.
BILLING_PROVIDER=mock
# payOS credentials, needed only for BILLING_PROVIDER=payos. Create the payment channel on
# https://my.payos.vn and copy the three values from there. Leave them blank and payOS stays
# unavailable: checkout with it is refused instead of silently taking no money.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Signs the .NET API's access tokens (Jwt__Secret); minimum 32 bytes.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
