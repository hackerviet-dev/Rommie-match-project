# Copy to .env for Docker Compose. Never commit real payOS credentials.
POSTGRES_DB=roomiematch
POSTGRES_USER=roomiematch
POSTGRES_PASSWORD=roomiematch_dev
POSTGRES_PORT=55432
API_PORT=5000
WEB_PORT=3100

# No provider is enabled by default. Use mock only for local tests.
BILLING_PROVIDER=
BILLING_PUBLIC_API_URL=http://localhost:5000
BILLING_RETURN_URL=http://localhost:3100/premium/result

# For real payOS payments, use newly rotated keys and BILLING_PROVIDER=payos.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Cloudinary for uploaded images (avatars, chat photos). Copy "API environment variable" from
# the Cloudinary dashboard (Settings > API Keys): cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# Staff analytics dashboard (GA4 Data API). Create a service account key in Google Cloud,
# enable "Google Analytics Data API", add the service account email as Viewer on the GA4
# property, then paste the key JSON on one line or its base64 here.
GA_SERVICE_ACCOUNT_JSON=

# Signs the .NET API's access tokens (Jwt__Secret); minimum 32 bytes.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
# Room location: browser key restricted to website referrers; server key kept private.
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_MAP_ID=
# Room photo uploads are signed by the backend. Never put the secret in VITE_*.
# All three values are required. Local Docker reads these from the ignored root .env.
# Render: set Cloudinary__CloudName, Cloudinary__ApiKey, Cloudinary__ApiSecret
# in the API service's Environment tab, then redeploy. Git push does not transfer .env.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
